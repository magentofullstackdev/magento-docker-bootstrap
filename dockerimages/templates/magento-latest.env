# Description: Magento 2.4.9 + PHP 8.5 + MariaDB 12.3 + OpenSearch 3.9 + Valkey 9 + Varnish 8
#
# Stack-only preset for `make configure PRESET=magento-latest`. PROJECT_NAME,
# SITE_HOST and USE_NODE are filled in by the wizard (or by env vars on the
# command line). All values below are validated against the compatibility
# matrix in dockerimages/bin/init.sh - update them in lockstep when the
# matrix moves. 2.4.9 mandates Valkey (Adobe dropped Redis from the certified
# matrix); leave CACHE_ENGINE=valkey alone. PHP 8.5 is the only version
# Adobe certifies on 2.4.9 (8.4 is upgrade-only).
FLAVOUR=magento
MAGENTO_VERSION=2.4.9
PHP_VERSION=8.5
DB_ENGINE=mariadb
DB_VERSION=12.3
OPENSEARCH_VERSION=3.9.0
CACHE_ENGINE=valkey
USE_VARNISH=yes
