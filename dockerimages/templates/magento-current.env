# Description: Magento 2.4.8 + PHP 8.4 + MariaDB 11.8 + OpenSearch 3.9 + Valkey 8.1 + Varnish 8
#
# Stack-only preset for `make configure PRESET=magento-current`. PROJECT_NAME,
# SITE_HOST and USE_NODE are filled in by the wizard (or by env vars on the
# command line). All values below are validated against the compatibility
# matrix in dockerimages/bin/init.sh - update them in lockstep when the
# matrix moves. The "production today" baseline: 2.4.8-p5 as Adobe certifies it
# (Valkey 8.1, Varnish 8, OpenSearch 3 latest minor).
FLAVOUR=magento
MAGENTO_VERSION=2.4.8
PHP_VERSION=8.4
DB_ENGINE=mariadb
DB_VERSION=11.8
OPENSEARCH_VERSION=3.9.0
CACHE_ENGINE=valkey
USE_VARNISH=yes
