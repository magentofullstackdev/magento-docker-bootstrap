# Description: MageOS 3.5.0 (Magento 2.4.9 base) + PHP 8.4 + MariaDB 12.3 + OpenSearch 3.9 + Valkey 8.1 + Varnish 7.7
#
# Stack-only preset for `make configure PRESET=mageos-latest`. PROJECT_NAME,
# SITE_HOST and USE_NODE are filled in by the wizard (or by env vars on the
# command line). All values below are validated against the compatibility
# matrix in dockerimages/bin/init.sh - update them in lockstep when the
# matrix moves. MageOS 3.x is the Magento 2.4.9 rebuild; 3.5.0 bundles Adobe's
# 2026 isolated security patches. PHP 8.4 is what MageOS CI runs on (8.5
# is allowed too).
FLAVOUR=mageos
MAGENTO_VERSION=3.5.0
PHP_VERSION=8.4
DB_ENGINE=mariadb
DB_VERSION=12.3
OPENSEARCH_VERSION=3.9.0
CACHE_ENGINE=valkey
USE_VARNISH=yes
