# Description: MageOS 2.3.0 (Magento 2.4.8-p5 base) + PHP 8.4 + MariaDB 11.8 + OpenSearch 3.0 + Valkey 8.1 + Varnish 7.7
#
# Stack-only preset for `make configure PRESET=mageos-legacy`. PROJECT_NAME,
# SITE_HOST and USE_NODE are filled in by the wizard (or by env vars on the
# command line). All values below are validated against the compatibility
# matrix in dockerimages/bin/init.sh - update them in lockstep when the
# matrix moves. 2.3.0 is the final MageOS 2.x release and receives no further
# upstream patches; use it only for projects still on the 2.4.8-based line.
FLAVOUR=mageos
MAGENTO_VERSION=2.3.0
PHP_VERSION=8.4
DB_ENGINE=mariadb
DB_VERSION=11.8
OPENSEARCH_VERSION=3.0.0
CACHE_ENGINE=valkey
USE_VARNISH=yes
