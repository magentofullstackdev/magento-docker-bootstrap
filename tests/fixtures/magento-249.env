SITE_HOST=smoketest.local
FLAVOUR=magento
MAGENTO_VERSION=2.4.9
PHP_VERSION=8.5
DB_ENGINE=mariadb
DB_VERSION=12.3
OPENSEARCH_VERSION=3.9.0
USE_VARNISH=no
USE_NODE=no
